# Copy to .env after deploying. Vite exposes only VITE_-prefixed vars.
VITE_CHAIN_ID=4663
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com/rpc

# Contract addresses (scripts/write-env.sh fills these from the broadcast log).
VITE_TOKEN_ADDRESS=
VITE_STAKING_ADDRESS=
VITE_DISTRIBUTOR_ADDRESS=

# Node Relics (nft-wireframe). VITE_RELIC_ADDRESS is the NodeRelic ERC721 — the
# same address the coordinator's RELIC_ADDRESS needs. VITE_RELIC_SALE_ADDRESS is
# the RelicSale contract the buy button calls. Mixing the two up leaves the page
# unable to read ownership and the coordinator unable to pay multipliers.
VITE_RELIC_ADDRESS=
VITE_RELIC_SALE_ADDRESS=

# Prod only: the deployed coordinator (Railway) URL, e.g. https://thicket-coordinator.up.railway.app
# Leave blank locally (dev uses the /api proxy). If set, the frontend calls it directly
# (make sure the coordinator's CORS_ORIGINS allows your Vercel origin).
VITE_COORDINATOR_URL=
