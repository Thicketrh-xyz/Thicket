{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/nodes",
      "destination": "/nodes.html"
    },
    {
      "source": "/nft",
      "destination": "/nft.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/:path*",
      "destination": "/docs.html"
    }
  ]
}
