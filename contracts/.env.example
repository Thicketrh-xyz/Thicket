# Robinhood Chain Testnet (chain ID 46630)
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
ROBINHOOD_MAINNET_RPC=

# Deployer / owner key. Fund it with testnet ETH first:
#   https://faucet.testnet.chain.robinhood.com
# NEVER commit a real key. Prefer:  export PRIVATE_KEY=0x...   in your shell.
PRIVATE_KEY=

# Address that publishes reward roots + slashes operators.
# Leave blank to use the deployer address. In prod use the coordinator's key/KMS.
COORDINATOR_ADDRESS=

# Economics (optional overrides, in wei). These are the variables the deploy
# script actually reads — INITIAL_SUPPLY / MAX_SUPPLY are from the old minting
# model and no longer exist.

# Full fixed supply, minted once to the deployer. Default 1,000,000,000 THKT.
TOTAL_SUPPLY=1000000000000000000000000000

# What the rewards pool OPENS with — not what it is meant to reach. The stated
# target is 350,000,000 THKT, grown from compute payments and treasury buybacks.
# Default 30,000,000 THKT. Everything not sent here stays in the treasury.
REWARDS_POOL=30000000000000000000000000

# Operator bond. Default 1,000 THKT.
MIN_OPERATOR_STAKE=1000000000000000000000
