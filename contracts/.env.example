# Robinhood Chain Testnet (chain ID 46630)
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
ROBINHOOD_MAINNET_RPC=

# Deployer / owner key. Fund it with testnet ETH first:
#   https://faucet.testnet.chain.robinhood.com
# NEVER commit a real key. Prefer:  export PRIVATE_KEY=0x...   in your shell.
PRIVATE_KEY=

# Address that publishes reward roots + slashes operators.
# Leave blank to use the deployer address. In prod use the coordinator's key/KMS.
COORDINATOR_ADDRESS=

# Economics (optional overrides; defaults shown, in wei)
INITIAL_SUPPLY=10000000000000000000000000
MAX_SUPPLY=100000000000000000000000000
MIN_OPERATOR_STAKE=1000000000000000000000
