# Copy to .env and fill in. Without these, ChainBridge runs in DRY mode
# (logs txs instead of sending them) so the sim/API work with no chain.

ROBINHOOD_RPC=
COORDINATOR_PRIVATE_KEY=      # publisher/slasher key — keep in a KMS/HSM in prod
STAKING_ADDRESS=             # deployed NodeStaking
DISTRIBUTOR_ADDRESS=         # deployed RewardsDistributor
