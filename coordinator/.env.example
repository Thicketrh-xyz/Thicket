# Copy to .env for local dev. In prod (Railway) set these as service variables.
# Without a key/addresses, ChainBridge runs in DRY mode (logs instead of sending).

# --- chain ---
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com/rpc
COORDINATOR_PRIVATE_KEY=      # publisher/slasher (0x14aA…779C). SECRET. Leave blank = DRY mode.
STAKING_ADDRESS=0x002497526d249f31f0ba5cb30627228c3b9b4e39
DISTRIBUTOR_ADDRESS=0xfe03bc178cff2149e84b4babb399083e31c637e2

# --- persistence ---
# Local default is SQLite (./thicket.db). In prod set the Postgres URL (Railway
# injects DATABASE_URL automatically when you attach a Postgres plugin).
DATABASE_URL=

# --- economics / cadence ---
REWARD_PER_MINUTE=1.0
EPOCH_SECONDS=3600            # how often the scheduler settles + publishes a root
CHALLENGE_INTERVAL_S=600
CHALLENGE_SIZE=128

# --- web ---
CORS_ORIGINS=*               # in prod, set to your Vercel origin, e.g. https://thicket.vercel.app
