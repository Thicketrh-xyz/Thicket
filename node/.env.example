# Copy to node/.env and fill in. Never commit a real key.

# Wallet the node runs as (the operator). Generate one with:
#   python -c "from eth_account import Account; a=Account.create(); print(a.address, a.key.hex())"
THICKET_PRIVATE_KEY=
NODE_ID=node-1

# Coordinator to report to (the live Thicket network).
COORDINATOR_URL=https://thicket-production.up.railway.app
HEARTBEAT_INTERVAL=30

# --- On-chain bonding (Robinhood Chain testnet, chain 46630) ---
# With these set, the node bonds itself as an operator on first run.
# The node wallet must hold BOND_AMOUNT THKT + a little ETH for gas.
ROBINHOOD_RPC=https://rpc.testnet.chain.robinhood.com/rpc
TOKEN_ADDRESS=0x4D4837ddb309a8dCeC3Abe727dbfED584771aEE2
STAKING_ADDRESS=0x434A64884B7C373eE145f11Ac9b7393723Ee5059
BOND_AMOUNT=          # human THKT; blank = contract minimum (1000)

# Set to true to skip on-chain bonding (use when the coordinator runs in DRY mode).
SKIP_BOND=false

# --- Model runtime (optional) ---
# Install Ollama (ollama.com) to serve real paid jobs. Without it the node still
# earns from uptime + challenges, it just won't be given compute jobs.
#   ollama pull llama3.2:1b     # text jobs
#   ollama pull llava:7b        # image->text (vision) jobs
OLLAMA_URL=http://localhost:11434
THICKET_TEXT_MODEL=llama3.2:1b
THICKET_VISION_MODEL=llava:7b
THICKET_JOB_TIMEOUT=180
